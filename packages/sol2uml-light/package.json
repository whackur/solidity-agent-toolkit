{
    "name": "sol2uml-light",
    "version": "2.5.27",
    "type": "commonjs",
    "engines": {
        "node": ">=20"
    },
    "description": "A lightweight Solidity contract visualisation tool based on sol2uml.",
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "scripts": {
        "buildSol": "cd ./src/contracts && solc **/*.sol",
        "build": "npm run clean && tsc --build --force ./tsconfig.json",
        "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
        "lint": "eslint src/ts --ignore-pattern '**/__tests__/**'",
        "package-lock": "npm i --package-lock-only",
        "permit": " chmod 775 lib/sol2uml.js",
        "prettier": "prettier --write src/**/*.ts **/*.md",
        "prettier:check": "prettier --check src/**/*.ts  **/*.md",
        "test": "jest --runInBand",
        "test:integration": "jest --runInBand --testRegex '/__tests__/.*\\.integration\\.test\\.ts$'",
        "prepack": "npm run build && npm run permit",
        "prepublishOnly": "npm run package-lock && npm run prepack"
    },
    "preferGlobal": true,
    "contributors": [
        "Nick Addison"
    ],
    "license": "MIT",
    "dependencies": {
        "@aduh95/viz.js": "^3.7.0",
        "@solidity-parser/parser": "^0.20.2",
        "axios": "^1.13.6",
        "axios-debug-log": "^1.0.0",
        "cli-color": "^2.0.4",
        "commander": "^12.1.0",
        "@resvg/resvg-js": "^2.6.2",
        "debug": "^4.4.1",
        "diff-match-patch": "^1.0.5",
        "ethers": "^6.16.0",
        "js-graph-algorithms": "^1.0.18",
        "klaw": "^4.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@openzeppelin/contracts": "^4.9.3",
        "@types/diff-match-patch": "^1.0.36",
        "@types/jest": "^30.0.0",
        "@types/klaw": "^3.0.8",
        "@types/node": "^20.19.43",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "jest": "^30.5.2",
        "prettier": "^3.9.10",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "files": [
        "lib/**/*.js",
        "lib/**/*.d.ts"
    ],
    "bin": {
        "sol2uml-light": "lib/sol2uml.js"
    },
    "keywords": [
        "Unified Modeling Language",
        "UML",
        "Solidity",
        "Ethereum",
        "diagram",
        "class",
        "diagram",
        "contract",
        "Blockchain",
        "storage",
        "flatten",
        "visual",
        "tool",
        "cli"
    ]
}

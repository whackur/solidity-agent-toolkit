{
  "name": "solidity-agent-toolkit",
  "version": "0.8.0",
  "description": "MCP server providing Solidity smart contract security analysis tools, OWASP knowledge base, and development utilities for AI agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whackur/solidity-agent-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/whackur/solidity-agent-toolkit/issues"
  },
  "homepage": "https://github.com/whackur/solidity-agent-toolkit#readme",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "solidity-agent-toolkit": "./dist/bin/cli.js",
    "solidity-agent-toolkit-lsp": "./dist/bin/lsp.js"
  },
  "files": [
    "dist/",
    "data/owasp-scs/docs/SCWE/",
    "data/owasp-scs/docs/sctop10/",
    "skills/"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "lsp": "tsx src/lsp/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "pnpm run lint:fix && pnpm run format",
    "version": "node scripts/sync-skill-versions.mjs && git add skills/"
  },
  "keywords": [
    "solidity",
    "smart-contracts",
    "ethereum",
    "security",
    "static-analysis",
    "vulnerability",
    "mcp",
    "model-context-protocol",
    "lsp",
    "language-server",
    "owasp",
    "ai-agent",
    "agent-skills",
    "skills",
    "foundry",
    "slither",
    "aderyn",
    "erc20",
    "erc721"
  ],
  "author": "whackur@gmail.com",
  "license": "MIT",
  "packageManager": "pnpm@10.29.3",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@solidity-parser/parser": "^0.20.2",
    "gray-matter": "^4.0.3",
    "vscode-languageserver": "^10.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  }
}

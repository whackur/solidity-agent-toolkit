{
  "name": "solidity-agent-toolkit",
  "version": "0.3.0",
  "description": "MCP server providing Solidity smart contract security analysis tools, OWASP knowledge base, and development utilities for AI agents",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "solidity-agent-toolkit": "./dist/bin/cli.js",
    "solidity-agent-toolkit-lsp": "./dist/bin/lsp.js"
  },
  "files": [
    "dist/",
    "data/owasp-scs/docs/SCWE/",
    "data/owasp-scs/docs/sctop10/",
    "skills/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "lsp": "tsx src/lsp/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "pnpm run lint:fix && pnpm run format",
    "version": "node scripts/sync-skill-versions.mjs && git add skills/"
  },
  "keywords": [
    "solidity",
    "smart-contracts",
    "ethereum",
    "security",
    "static-analysis",
    "vulnerability",
    "mcp",
    "model-context-protocol",
    "lsp",
    "language-server",
    "owasp",
    "ai-agent",
    "agent-skills",
    "skills",
    "foundry",
    "slither",
    "aderyn",
    "erc20",
    "erc721"
  ],
  "author": "whackur@gmail.com",
  "license": "MIT",
  "packageManager": "pnpm@10.29.3",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "gray-matter": "^4.0.3",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vitest": "^4.0.18"
  }
}

{
  "name": "solidity-agent-toolkit",
  "version": "0.9.1",
  "description": "MCP server providing Solidity smart contract security analysis tools, OWASP knowledge base, and development utilities for AI agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whackur/solidity-agent-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/whackur/solidity-agent-toolkit/issues"
  },
  "homepage": "https://github.com/whackur/solidity-agent-toolkit#readme",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "solidity-agent-toolkit": "dist/bin/cli.js",
    "solidity-agent-toolkit-lsp": "dist/bin/lsp.js",
    "sol2uml-light": "packages/sol2uml-light/lib/sol2uml.js"
  },
  "files": [
    "dist/",
    "packages/sol2uml-light/AGENTS.md",
    "packages/sol2uml-light/CLAUDE.md",
    "packages/sol2uml-light/LICENSE",
    "packages/sol2uml-light/README.md",
    "packages/sol2uml-light/package.json",
    "packages/sol2uml-light/tsconfig.json",
    "packages/sol2uml-light/version2.md",
    "packages/sol2uml-light/examples/",
    "packages/sol2uml-light/lib/**/*.js",
    "packages/sol2uml-light/lib/**/*.d.ts",
    "packages/sol2uml-light/src/ts/**/*.ts",
    "data/owasp-scs/docs/SCWE/",
    "data/owasp-scs/docs/sctop10/",
    "guides/"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm run build:sol2uml-light && tsc",
    "build:sol2uml-light": "pnpm run clean:sol2uml-light && tsc --build --force packages/sol2uml-light/tsconfig.json",
    "clean:sol2uml-light": "node -e \"require('node:fs').rmSync('packages/sol2uml-light/lib', { recursive: true, force: true })\"",
    "dev": "tsx src/index.ts",
    "lsp": "tsx src/lsp/server.ts",
    "test": "vitest run",
    "test:sol2uml-light": "cd packages/sol2uml-light && node ../../node_modules/jest/bin/jest.js --runInBand",
    "test:sol2uml-light:integration": "cd packages/sol2uml-light && node ../../node_modules/jest/bin/jest.js --runInBand --testRegex='/__tests__/.*\\.integration\\.test\\.ts$'",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build",
    "lint": "eslint src/ && pnpm run lint:sol2uml-light",
    "lint:sol2uml-light": "eslint --config packages/sol2uml-light/eslint.config.mjs packages/sol2uml-light/src/ts --ignore-pattern '**/__tests__/**'",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "pnpm run lint:fix && pnpm run format"
  },
  "keywords": [
    "solidity",
    "smart-contracts",
    "ethereum",
    "security",
    "static-analysis",
    "vulnerability",
    "mcp",
    "model-context-protocol",
    "lsp",
    "language-server",
    "owasp",
    "ai-agent",
    "foundry",
    "slither",
    "aderyn",
    "erc20",
    "erc721"
  ],
  "author": "whackur@gmail.com",
  "license": "MIT",
  "packageManager": "pnpm@11.28.8",
  "dependencies": {
    "@aduh95/viz.js": "^3.7.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@resvg/resvg-js": "^2.6.2",
    "@solidity-parser/parser": "^0.20.2",
    "axios": "^1.13.6",
    "axios-debug-log": "^1.0.0",
    "cli-color": "^2.0.4",
    "commander": "^12.1.0",
    "debug": "^4.4.1",
    "diff-match-patch": "^1.0.5",
    "ethers": "^6.16.0",
    "gray-matter": "^4.0.3",
    "js-graph-algorithms": "^1.0.18",
    "klaw": "^4.1.0",
    "vscode-languageserver": "^11.0.0",
    "vscode-languageserver-textdocument": "^1.0.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/diff-match-patch": "^1.0.36",
    "@types/jest": "^30.0.0",
    "@types/klaw": "^3.0.8",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "directories": {
    "doc": "docs",
    "example": "examples"
  }
}
